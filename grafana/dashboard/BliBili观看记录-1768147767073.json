          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  view_at as \"时间\",\r\n  NULL AS \"作者名称\",\r\n  NULL AS \"标题\"\r\nFROM bilibili_history\r\nWHERE\r\n  $__timeFilter(view_at)\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n  CASE\r\n    -- 当 progress 为 -1 或 0 时，减 duration\r\n    WHEN progress = -1 OR progress = 0 THEN view_at - (duration * interval '1 second')\r\n    -- 其他情况，减 progress\r\n    ELSE view_at - (progress * interval '1 second')\r\n  END as \"时间\",\r\n  author_name as \"作者名称\",\r\n  title as \"标题\"\r\nFROM bilibili_history\r\nWHERE\r\n  $__timeFilter(view_at)\r\n\r\nORDER BY\r\n  1 ASC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
