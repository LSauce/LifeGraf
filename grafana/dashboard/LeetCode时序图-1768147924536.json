      "targets": [
        {
          "dataset": "life_graf",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${PostgreSql}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH source_data AS (\r\n  SELECT\r\n    submit_time,\r\n    user_slug,\r\n    title_slug,\r\n    question_translated_title,\r\n    -- 获取该用户按时间排序的下一条提交的 title_slug\r\n    LEAD(title_slug) OVER (\r\n      PARTITION BY user_slug \r\n      ORDER BY submit_time\r\n    ) as next_title_slug\r\n  FROM\r\n    leetcode_submission\r\n  WHERE\r\n    $__timeFilter(submit_time)\r\n)\r\n\r\n-- 1. 原始数据点：代表题目的开始或持续\r\nSELECT\r\n  submit_time AS \"time\",\r\n  user_slug AS \"metric\",\r\n  question_translated_title AS \"value\"\r\nFROM\r\n  source_data\r\n\r\nUNION ALL\r\n\r\n-- 2. 结束数据点：在题目切换或结束时，插入 NULL\r\nSELECT\r\n  -- PostgreSQL 时间加法语法\r\n  submit_time + interval '1 second' AS \"time\",\r\n  user_slug AS \"metric\",\r\n  NULL AS \"value\"\r\nFROM\r\n  source_data\r\nWHERE\r\n  -- 当下一题和当前题不一样 (IS DISTINCT FROM 处理了 NULL 的情况)\r\n  next_title_slug IS DISTINCT FROM title_slug\r\n\r\nORDER BY 1",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [
                  {
                    "name": "*",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          },
          "table": "leetcode_submission"
        }
      ],
