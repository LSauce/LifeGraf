          "rawSql": "SELECT\r\n  -- 1. 将时间截断到“天”\r\n  DATE_TRUNC('day', submit_time) AS \"time\",\r\n  -- 2. 以 user_slug 作为线条分组\r\n  user_slug AS \"metric\",\r\n  -- 3. 统计当天的提交次数\r\n  COUNT(submission_id) AS \"value\"\r\nFROM\r\n  leetcode_submission\r\nWHERE\r\n  -- 强制筛选最近 30 天 (忽略 Dashboard 全局时间)\r\n  submit_time >= NOW() - INTERVAL '30 days'\r\nGROUP BY\r\n  1,\r\n  2\r\nORDER BY\r\n  1",
