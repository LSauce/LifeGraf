        {
          "dataset": "life_graf",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${PostgreSql}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- 首先，创建一个包含过去 7 天的日期序列\r\nWITH date_series AS (\r\n    SELECT generate_series(\r\n        date_trunc('day', NOW() - INTERVAL '$showDays days'), -- 从6天前开始（包含今天，共7天）\r\n        date_trunc('day', NOW()),\r\n        '1 day'::interval\r\n    ) AS day\r\n),\r\nplayer_status AS (\r\n    SELECT\r\n        time,\r\n        game_name,\r\n        -- 获取下一条记录的时间，用于计算当前状态持续了多久\r\n        LEAD(time) OVER (PARTITION BY steam_id ORDER BY time) as next_time,\r\n        steam_id\r\n    FROM steam_player_gaming\r\n    WHERE\r\n        steam_id = '$SteamId'\r\n        AND time >= NOW() - INTERVAL '7 days'\r\n),\r\ndurations AS (\r\n    SELECT\r\n        -- 使用 TimescaleDB 的 time_bucket 按天分组\r\n        time_bucket('1 day', time) AS day,\r\n        game_name,\r\n        -- 计算持续时间（秒）\r\n        -- 过滤：如果两条记录间隔超过 10 分钟，认为中间已下线，不计入时长\r\n        EXTRACT(EPOCH FROM (next_time - time)) AS duration_seconds\r\n    FROM player_status\r\n    WHERE\r\n        game_name IS NOT NULL\r\n        AND next_time IS NOT NULL\r\n        AND (next_time - time) < INTERVAL '10 minutes' -- 采样间隔阈值，可根据抓取频率调整\r\n),\r\n-- 计算每天每个游戏的总时长\r\ndaily_playtime AS (\r\n    SELECT\r\n        day AS \"time\",\r\n        game_name AS metric,\r\n        SUM(duration_seconds) / 60.0 AS play_minutes -- 转换为分钟\r\n    FROM durations\r\n    GROUP BY 1, 2\r\n)\r\n-- 将日期序列与游戏时长数据进行左连接，以填充缺失的日期\r\nSELECT\r\n    d.day AS \"time\",\r\n    COALESCE(dp.metric, 'No Game Played') AS metric, -- 如果当天没有玩游戏，可以给一个默认值\r\n    COALESCE(dp.play_minutes, 0) AS play_minutes -- 如果当天没有玩游戏，时长计为 0\r\nFROM date_series d\r\nLEFT JOIN daily_playtime dp ON d.day = dp.time\r\nORDER BY d.day, metric;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "游戏时间统计",
      "transformations": [
